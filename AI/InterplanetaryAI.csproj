<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>InterplanetaryAI</AssemblyName>
    <RootNamespace>InterplanetaryAI</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.22.0</Version>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Without this MSBuild refuses to resolve Assembly-CSharp (MSB3258). -->
    <_FindDependencies>false</_FindDependencies>
    <!-- The game folder supplies the referenced DLLs (game + BepInEx). Default: the standard Steam library.
         Override for another library: dotnet build AI -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Interplanetary Enhanced Edition" -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Interplanetary Enhanced Edition</GameDir>
    <ManagedDir>$(GameDir)\Interplanetary_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <!-- v0.20: the StampBuild target sets InformationalVersion itself (short commit + dirty flag). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- v0.20 (council I1a): stamp the git commit and a dirty flag into InformationalVersion ("0.20.0+abc1234" or
       "0.20.0+abc1234.dirty"); the plugin logs it in every init record so a data set names the tree that produced it. -->
  <Target Name="StampBuild" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD 2&gt;nul" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=all -- *.cs *.csproj Brain 2&gt;nul" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirty" />
    </Exec>
    <PropertyGroup>
      <GitCommit Condition="'$(GitCommit)' == ''">nogit</GitCommit>
      <InformationalVersion>$(Version)+$(GitCommit)</InformationalVersion>
      <InformationalVersion Condition="'$(GitDirty)' != ''">$(Version)+$(GitCommit).dirty</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Fail early with a clear message when the game (or BepInEx) is not where GameDir points. -->
  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Game not found: $(ManagedDir)\Assembly-CSharp.dll is missing. Pass the game folder with -p:GameDir=&quot;...\Interplanetary Enhanced Edition&quot;." />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')" Text="BepInEx not found: $(BepInExCore)\BepInEx.dll is missing. Install BepInEx 5.4.x x64 into the game folder and run the game once." />
  </Target>

  <!-- v0.20 (council I1b): one version source. The build fails when <Version> and Plugin.VERSION disagree. -->
  <Target Name="CheckVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginSource>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Plugin.cs'))</PluginSource>
      <PluginVersion>$([System.Text.RegularExpressions.Regex]::Match($(PluginSource), 'VERSION = "([0-9.]+)"').Groups[1].Value)</PluginVersion>
    </PropertyGroup>
    <Error Condition="'$(PluginVersion)' != '$(Version)'" Text="Version mismatch: csproj $(Version) vs Plugin.VERSION $(PluginVersion)." />
  </Target>

  <!-- v0.20 (council I1b): deploying into the game folder is opt-in (-p:Deploy=true) and refuses while the game runs.
       A plain `dotnet build AI -c Release` never touches the game. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Exec Command="tasklist /FI &quot;IMAGENAME eq Interplanetary.exe&quot; /NH" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GameProcesses" />
    </Exec>
    <Error Condition="$(GameProcesses.Contains('Interplanetary.exe'))" Text="Interplanetary.exe is running: close the game before deploying." />
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\InterplanetaryAI" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\InterplanetaryAI" />
  </Target>

</Project>
