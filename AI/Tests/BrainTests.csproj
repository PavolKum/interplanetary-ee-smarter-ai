<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner for the game-independent Brain code. Run: dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Brain\*.cs" Link="Brain\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
