+        {
+            Point P(float x) { return new Point(x, 0f, 0f); }
+            float r = 5.9f;
+
+            // A defense covers what is strictly inside its radius.
+            var line = new List<Point> { P(0f), P(3f), P(5.9f), P(7f) };
