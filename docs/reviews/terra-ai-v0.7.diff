+        private sealed class CoverageState
+        {
+            public List<BaseBuilding> Bases;
+            public BaseBuilding Anchor;
+            public int AnchorIndex = -1;
+            public int Steps;
+            public bool GaveUp;
+            public readonly HashSet<int> Excluded = new HashSet<int>();
