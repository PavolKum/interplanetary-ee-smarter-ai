import json, collections
M=["v018m22","v018m23","v018m24","v019m25","v019m26"]
IG={"Nanto","Helios","Uuno","Ruffian"}
print("== per fire turn: powered vs paid, strategy shots/hold, intercepts observed, energy withheld ==")
for m in M:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if d.get("e")=="init" and d.get("smart") and d["ai"] not in IG}
    for ai in sorted(smart):
        powered=0; paid=0; nfire=0; cand0=0
        for d in recs:
            if d.get("ai")!=ai: continue
            if d.get("e")=="fire":
                nfire+=1; powered+=d.get("powered",0)
                if d.get("assigned",{}).get("jogi",0)>0 and d.get("primaryByTarget",{}).get("jogi",0)==0: pass
            elif d.get("e")=="fire-paid":
                paid+=1
                if d.get("candidates")==0: cand0+=1
        # strategy aggregates
        shots=sum(d.get("shots",0) for d in recs if d.get("ai")==ai and d.get("e")=="strategy")
        holds=sum(d.get("holdTurns",0) for d in recs if d.get("ai")==ai and d.get("e")=="strategy")
        fireFalse=sum(1 for d in recs if d.get("ai")==ai and d.get("e")=="strategy" and not d.get("fire"))
        inter=sum(d.get("observedInterceptedBy",{}).get("jogi",0) for d in recs if d.get("ai")==ai and d.get("e")=="strategy")
        impacts=sum(d.get("observedImpactsBy",{}).get("jogi",0) for d in recs if d.get("ai")==ai and d.get("e")=="strategy")
        lff=[d for d in recs if d.get("ai")==ai and d.get("e")=="late-free-fire"]
        lshots=sum(d.get("shots",0) for d in lff)
        print(f"{m} {ai}: fireTurns={nfire} poweredSum={powered} paidShots={paid} paidWithCand0={cand0} strategyShots={shots} holdTurns={holds} strategyFireFalse={fireFalse} interceptsJogi={inter} impactsJogi={impacts} lateFreeShots={lshots}")
