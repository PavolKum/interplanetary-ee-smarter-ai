import json, collections
def K(d,k,dv=None): return d.get(k,dv)
# per-AI placement failures for v0.19 matches
for m in ["v019m25","v019m26"]:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    per=collections.defaultdict(collections.Counter)
    for d in recs:
        if K(d,"e")=="director" and "placementFailures" in d:
            pf=K(d,"placementFailures")
            if isinstance(pf,dict):
                for k,v in pf.items(): per[K(d,"ai")][k]+=v
    print(m)
    tot=collections.Counter()
    for ai,c in per.items():
        print("  ",ai, sum(c.values()), dict(c)); tot.update(c)
    print("   TOTAL", sum(tot.values()), dict(tot))
# peak energyPerTurn (income) and stock per smart AI
IG={"Nanto","Helios","Uuno","Ruffian"}
for m in ["v019m25","v019m26"]:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if K(d,"e")=="init" and K(d,"smart") and K(d,"ai") not in IG}
    for ai in sorted(smart):
        ept=max(K(d,"energyPerTurn") for d in recs if K(d,"e")=="economy" and K(d,"ai")==ai)
        estock=max(K(d,"energy") for d in recs if K(d,"e")=="economy" and K(d,"ai")==ai)
        mstock=max(K(d,"material") for d in recs if K(d,"e")=="economy" and K(d,"ai")==ai)
        print(m,ai,"peakEPerTurn",ept,"peakEstock",estock,"peakMstock",mstock)
