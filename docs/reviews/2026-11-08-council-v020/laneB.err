import json
def dump(m,ai):
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    print(f"== {m} {ai} ==")
    print(" t | strat fire reason passShare shots | powered primF sec fired paid | energy mat")
    for t in range(1,40):
        s=[d for d in recs if d.get("ai")==ai and d.get("t")==t]
        st=[d for d in s if d.get("e")=="strategy"]; f=[d for d in s if d.get("e")=="fire"]; fp=[d for d in s if d.get("e")=="fire-paid"]; ec=[d for d in s if d.get("e")=="economy"]
        if not any([st,f,ec]): continue
        line=f"{t:2} |"
        if st: line+=f" {int(st[0].get(chr(102)+chr(105)+chr(114)+chr(101),0))} {st[0].get(chr(114)+chr(101)+chr(97)+chr(115)+chr(111)+chr(110),chr(63))[:12]} ps={st[0].get(chr(112)+chr(97)+chr(115)+chr(115)+chr(83)+chr(104)+chr(97)+chr(114)+chr(101),0):.1f} sh={st[0].get(chr(115)+chr(104)+chr(111)+chr(116)+chr(115),0)}"
        line+=" |"
        if f: line+=f" pw={f[0].get(chr(112)+chr(111)+chr(119)+chr(101)+chr(114)+chr(101)+chr(100))} pr={f[0].get(chr(112)+chr(114)+chr(105)+chr(109)+chr(97)+chr(114)+chr(121)+chr(70)+chr(111)+chr(117)+chr(110)+chr(100))} sec={f[0].get(chr(115)+chr(101)+chr(99)+chr(111)+chr(110)+chr(100)+chr(97)+chr(114)+chr(121)+chr(79)+chr(110)+chr(108)+chr(121))} fired={f[0].get(chr(102)+chr(105)+chr(114)+chr(105)+chr(110)+chr(103)+chr(72)+chr(105)+chr(116)+chr(115),0)+f[0].get(chr(102)+chr(105)+chr(114)+chr(105)+chr(110)+chr(103)+chr(77)+chr(105)+chr(115)+chr(115)+chr(101)+chr(115),0)}"
        line+=f" paid={len(fp)}"
        if ec: line+=f" | E={ec[0].get(chr(101)+chr(110)+chr(101)+chr(114)+chr(103)+chr(121))} M={ec[0].get(chr(109)+chr(97)+chr(116)+chr(101)+chr(114)+chr(105)+chr(97)+chr(108))}"
        print(line)
dump("v018m22","Eiai")
