import json
def dump(m,ai,tmax):
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    print(f"== {m} {ai} ==")
    for t in range(1,tmax+1):
        s=[d for d in recs if d.get("ai")==ai and d.get("t")==t]
        st=[d for d in s if d.get("e")=="strategy"]; f=[d for d in s if d.get("e")=="fire"]; fp=[d for d in s if d.get("e")=="fire-paid"]; ec=[d for d in s if d.get("e")=="economy"]
        if not any([st,f,ec]): continue
        parts=[f"{t:2} |"]
        if st: parts.append(f"{int(st[0].get(\"fire\",0))} {st[0].get(\"reason\",\"?\")[:13]} ps={st[0].get(\"passShare\",0):.1f} sh={st[0].get(\"shots\",0)} arr={st[0].get(\"arriving\",0)}")
        p=""
        if f: p=f" pw={f[0].get(\"powered\")} pr={f[0].get(\"primaryFound\")} fired={f[0].get(\"firingHits\",0)+f[0].get(\"firingMisses\",0)}"
        parts.append(p+f" paid={len(fp)}")
        if ec: parts.append(f"| E={ec[0].get(\"energy\")} M={ec[0].get(\"material\")}")
        print(" ".join(parts))
dump("v019m25","Zenon",38)
