import json
M=["v018m22","v018m23","v018m24","v019m25","v019m26"]
IG={"Nanto","Helios","Uuno","Ruffian"}
for m in M:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if d.get("e")=="init" and d.get("smart") and d["ai"] not in IG}
    for ai in sorted(smart):
        mine=[d for d in recs if d.get("ai")==ai]
        fires=[d["t"] for d in mine if d.get("e")=="fire"]
        fp=[d["t"] for d in mine if d.get("e")=="fire-paid"]
        wt=None
        for d in mine:
            if d.get("e")=="strategy" and d.get("war"): wt=d["t"]; break
        ws=min(fires) if fires else None
        war_e=[(d["t"],d["energy"],d["material"]) for d in mine if d.get("e")=="economy" and ws and d["t"]>=ws]
        emax=max((e for _,e,_ in war_e), default=0); mmax=max((ma for _,_,ma in war_e), default=0)
        emean=sum(e for _,e,_ in war_e)/len(war_e) if war_e else 0
        mmean=sum(ma for _,_,ma in war_e)/len(war_e) if war_e else 0
        print(f"{m} {ai}: strategyWarT={wt} firstFireT={ws} firstPaidT={min(fp) if fp else None} nFire={len(fires)} warTurns={len(war_e)} E max/mean={emax:.0f}/{emean:.0f} Mat max/mean={mmax:.0f}/{mmean:.0f}")
