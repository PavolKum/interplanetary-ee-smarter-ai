import json, collections
print("== human telemetry: pop + buildings per turn, damage events ==")
for m in ["v018m22","v018m23","v018m24","v019m25","v019m26"]:
    snap={}; kinds=collections.Counter(); shots=0; shotsAtOther=0
    for l in open(f"docs/playtests/data/{m}-human-telemetry.jsonl",encoding="utf-8"):
        d=json.loads(l)
        et=d.get("eventType")
        if et in ("round_start","turn_end") and d.get("state"):
            p=d["state"]["player"]
            if p.get("status")=="Playing":
                snap[d["turn"]]=(p["resources"]["populationMillions"], {b["id"]:b["count"] for b in p.get("buildings",[])})
        elif et=="damage" and d.get("damage"): kinds[d["damage"]["kind"]]+=1
        elif et=="shot" and d.get("shot"):
            shots+=1
            if d["shot"].get("hitOtherPlayerPlanet"): shotsAtOther+=1
    last=max(snap)
    print(m,"turns:",min(snap),"-",last,"finalPop:",snap[last][0],"humanShots:",shots,"hitOtherPlanet:",shotsAtOther,"damageKinds:",dict(kinds))
    print("   pop series:", [(t,s[0]) for t,s in sorted(snap.items()) if t%4==0 or t==last])
    print("   finalBuildings:", snap[last][1])
