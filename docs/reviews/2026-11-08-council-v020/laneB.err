import json, collections
def K(d,k,dv=None): return d.get(k,dv)
print("== v0.19: paid shots on strategy-fire turns vs hold turns; nukes fired ==")
for m in ["v019m25","v019m26"]:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    strat={}
    for d in recs:
        if K(d,"e")=="strategy": strat[(K(d,"ai"),K(d,"t"))]=K(d,"fire")
    per=collections.defaultdict(lambda:[0,0,0])
    nukes=0
    for d in recs:
        if K(d,"e")=="fire-paid":
            ai=K(d,"ai"); on = strat.get((ai,K(d,"t")))
            if on is True: per[ai][0]+=1
            elif on is False: per[ai][1]+=1
            else: per[ai][2]+=1
            if K(d,"wid")=="wea_NuclearMissile": nukes+=1
    print(m, {ai:tuple(v) for ai,v in per.items()}, "nukesPaid:",nukes)
# Ash war/peace flip
recs=[json.loads(l) for l in open("docs/playtests/data/v019m26-ai-decisions.jsonl",encoding="utf-8")]
print("Ash strategy:", [(K(d,"t"),int(K(d,"war")),K(d,"reason")) for d in recs if K(d,"e")=="strategy" and K(d,"ai")=="Ash" and 16<=K(d,"t")<=22])
# Eiai peak E per turn + Eddie/Doc peak E per turn (m24)
for m,ai in [("v018m22","Eiai"),("v018m24","Eddie"),("v018m24","Doc")]:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    ept=max(K(d,"energyPerTurn") for d in recs if K(d,"e")=="economy" and K(d,"ai")==ai)
    est=max(K(d,"energy") for d in recs if K(d,"e")=="economy" and K(d,"ai")==ai)
    print(m,ai,"peakEPerTurn",ept,"peakEstock",est)
