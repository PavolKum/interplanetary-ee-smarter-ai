import json, collections
M=["v018m22","v018m23","v018m24","v019m25","v019m26"]
IG={"Nanto","Helios","Uuno","Ruffian"}
print("== weapons owned per smart AI over time (from economy.buildings) ==")
for m in M:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if d.get("e")=="init" and d.get("smart") and d["ai"] not in IG}
    print(m)
    for ai in sorted(smart):
        ser=[]
        for d in recs:
            if d.get("e")=="economy" and d.get("ai")==ai:
                b=d.get("buildings",{})
                w=sum(v for k,v in b.items() if "Railgun" in k or "Missile" in k or "Coilcannon" in k)
                ser.append((d["t"],w))
        peaks=sorted(ser,key=lambda x:-x[1])
        ws=min(t for t,w in ser if w>0) if any(w>0 for t,w in ser) else None
        print(f"  {ai}: firstWeaT={ws} peakWea={peaks[0] if peaks else None} finalWea={ser[-1] if ser else None} atT21={dict(ser).get(21)} atT30={dict(ser).get(30)}")
'
