import json, collections
M=["v018m22","v018m23","v018m24","v019m25","v019m26"]
IG={"Nanto","Helios","Uuno","Ruffian"}
print("== aim-search: found/live on fire turns vs all turns; and assigned[jogi] sums ==")
for m in M:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if d.get("e")=="init" and d.get("smart") and d["ai"] not in IG}
    fireTurns=collections.defaultdict(set)
    for d in recs:
        if d.get("e")=="fire" and d.get("ai") in smart: fireTurns[d["ai"]].add(d["t"])
    jsum=collections.defaultdict(int); primJ=collections.defaultdict(int)
    for d in recs:
        if d.get("e")=="fire" and d.get("ai") in smart:
            jsum[d["ai"]]+=d.get("assigned",{}).get("jogi",0)
            primJ[d["ai"]]+=d.get("primaryByTarget",{}).get("jogi",0)
    stats=collections.defaultdict(lambda:[0,0,0,0,0])  # all live,all found, fireTurns live, found, n
    for d in recs:
        if d.get("e")=="aim-search" and d.get("ai") in smart:
            onfire=d["t"] in fireTurns[d["ai"]]
            s=stats[d["ai"]]; s[0]+=d.get("live",0); s[1]+=d.get("found",0)
            if onfire: s[2]+=d.get("live",0); s[3]+=d.get("found",0); s[4]+=1
    print(m)
    for ai in sorted(smart):
        s=stats[ai]
        allr=s[1]/s[0] if s[0] else 0; fr=s[3]/s[2] if s[2] else 0
        print(f"  {ai}: all found/live={s[1]}/{s[0]}={allr:.2f} | onFireTurns {s[3]}/{s[2]}={fr:.2f} (n={s[4]}) | assignedJogi={jsum[ai]} primaryJogi={primJ[ai]}")
'
