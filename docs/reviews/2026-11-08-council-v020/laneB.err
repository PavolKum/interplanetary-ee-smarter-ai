import json, collections
keys=collections.Counter(); vals=collections.defaultdict(set)
for m in ["v018m22","v018m23","v018m24","v019m25","v019m26"]:
    for line in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8"):
        d=json.loads(line)
        for k in d: keys[k]+=1
        if d.get("e")=="economy":
            for k in d.get("buildings",{}): vals["econB"].add(k)
        if d.get("e")=="superweapon": vals["sw"].add(json.dumps(d)[:120])
        if "fail" in json.dumps(d).lower(): vals["fail"].add((m,d.get("e")))
print("ALLKEYS:", sorted(keys))
print("ECONBUILDINGS:", sorted(vals["econB"]))
print("FAIL hits sample:", list(vals["fail"])[:20])
print("SUPERWEAPON sample:", list(vals["sw"])[:3])
