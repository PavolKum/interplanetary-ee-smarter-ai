import json
def K(d,k,dv=None): return d.get(k,dv)
def dump(m,ai,tmax):
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    print(f"== {m} {ai} ==")
    for t in range(1,tmax+1):
        s=[d for d in recs if K(d,"ai")==ai and K(d,"t")==t]
        st=[d for d in s if K(d,"e")=="strategy"]; f=[d for d in s if K(d,"e")=="fire"]; fp=[d for d in s if K(d,"e")=="fire-paid"]; ec=[d for d in s if K(d,"e")=="economy"]
        if not any([st,f,ec]): continue
        line=f"{t:2} |"
        if st: line+=f" {int(K(st[0],chr(102)+chr(105)+chr(114)+chr(101)))} {K(st[0],chr(114)+chr(101)+chr(97)+chr(115)+chr(111)+chr(110),chr(63))[:13]} ps={K(st[0],chr(112)+chr(97)+chr(115)+chr(115)+chr(83)+chr(104)+chr(97)+chr(114)+chr(101))} sh={K(st[0],chr(115)+chr(104)+chr(111)+chr(116)+chr(115))} arr={K(st[0],chr(97)+chr(114)+chr(114)+chr(105)+chr(118)+chr(105)+chr(110)+chr(103))}"
        line+=" |"
        if f: line+=f" pw={K(f[0],chr(112)+chr(111)+chr(119)+chr(101)+chr(114)+chr(101)+chr(100))} pr={K(f[0],chr(112)+chr(114)+chr(105)+chr(109)+chr(97)+chr(114)+chr(121)+chr(70)+chr(111)+chr(117)+chr(110)+chr(100))} fired={K(f[0],chr(102)+chr(105)+chr(114)+chr(105)+chr(110)+chr(103)+chr(72)+chr(105)+chr(116)+chr(115),0)+K(f[0],chr(102)+chr(105)+chr(114)+chr(105)+chr(110)+chr(103)+chr(77)+chr(105)+chr(115)+chr(115)+chr(101)+chr(115),0)}"
        line+=f" paid={len(fp)}"
        if ec: line+=f" | E={K(ec[0],chr(101)+chr(110)+chr(101)+chr(114)+chr(103)+chr(121))} M={K(ec[0],chr(109)+chr(97)+chr(116)+chr(101)+chr(114)+chr(105)+chr(97)+chr(108))}"
        print(line)
