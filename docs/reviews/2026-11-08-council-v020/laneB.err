import json, collections
M=["v018m22","v018m23","v018m24","v019m25","v019m26"]
IG={"Nanto","Helios","Uuno","Ruffian"}
for m in M:
    recs=[json.loads(l) for l in open(f"docs/playtests/data/{m}-ai-decisions.jsonl",encoding="utf-8")]
    smart={d["ai"] for d in recs if d.get("e")=="init" and d.get("smart") and d["ai"] not in IG}
    agg=collections.defaultdict(lambda: [0,0,0,0,0,0,0,0])  # nFire, plannedHits, plannedMisses, firingHits, firingMisses, paid, paidHuman, paidOther
    for d in recs:
        ai=d.get("ai")
        if ai not in smart: continue
        e=d.get("e")
        if e=="fire":
            a=agg[ai]; a[0]+=1; a[1]+=d.get("plannedHits",0); a[2]+=d.get("plannedMisses",0); a[3]+=d.get("firingHits",0); a[4]+=d.get("firingMisses",0)
        elif e=="fire-paid":
            a=agg[ai]; a[5]+=1
            if d.get("destination")=="jogi": a[6]+=1
            elif d.get("destination") not in (None,"jogi"): a[7]+=1
    print(m)
    for ai in sorted(agg):
        a=agg[ai]
        print(f"  {ai}: fireEvents={a[0]} plannedHits={a[1]} plannedMisses={a[2]} firingHits={a[3]} firingMisses={a[4]} paidShots={a[5]} paid@jogi={a[6]} paid@other={a[7]}")
