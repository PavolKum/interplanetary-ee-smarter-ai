import json
for m,p in [('M25','docs/playtests/data/v019m25-human-telemetry.jsonl'),('M26','docs/playtests/data/v019m26-human-telemetry.jsonl')]:
    peak=(0,None)
    t29=None
    with open(p,encoding='utf-8') as f:
        for l in f:
            r=json.loads(l)
            if r.get('eventType')=='checkpoint' and r.get('phase')=='PlayerTurn':
                st=r.get('state') or {}
                pl=st.get('player',{}).get('resources',{})
                e=pl.get('energyPerTurn')
                if isinstance(e,(int,float)):
                    if e>peak[0]: peak=(e,r.get('turn'))
                    if r.get('turn')==29: t29=e
    print(m,'peak energyPerTurn %.0f at T%s'%(peak[0],peak[1]),' T29:',t29)
"
