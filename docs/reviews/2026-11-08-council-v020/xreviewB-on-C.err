import json
p='docs/playtests/data/v019m25-ai-decisions.jsonl'
perturn={}
with open(p,encoding='utf-8') as f:
    for l in f:
        r=json.loads(l)
        if r.get('e')=='fire':
            t=r.get('t')
            prim=r.get('primaryByTarget') or {}
            ph=r.get('plannedHits',0); pm=r.get('plannedMisses',0)
            # count shots aimed at jogi as primary
            perturn.setdefault(t,[0,0,0])
            perturn[t][0]+=ph+pm
            j=prim.get('jogi')
            if j: perturn[t][1]+=ph+pm
            perturn[t][2]+=1
war=[(t,v) for t,v in sorted(perturn.items()) if t>=21]
print('turn: allShots humanShots volleys')
for t,(a,h,n) in war: print('T%d %d %d %d'%(t,a,h,n))
ht=sum(v[1] for v in perturn.values()); at=sum(v[0] for v in perturn.values())
print('total planned shots all targets:',at,' at human:',ht)
