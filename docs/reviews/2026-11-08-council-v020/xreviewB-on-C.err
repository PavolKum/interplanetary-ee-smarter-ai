import json
for m,p in [('M22','docs/playtests/data/v018m22-ai-decisions.jsonl'),('M23','docs/playtests/data/v018m23-ai-decisions.jsonl'),('M24','docs/playtests/data/v018m24-ai-decisions.jsonl'),('M25','docs/playtests/data/v019m25-ai-decisions.jsonl'),('M26','docs/playtests/data/v019m26-ai-decisions.jsonl')]:
    vals=[]; turns=[]
    with open(p,encoding='utf-8') as f:
        for l in f:
            r=json.loads(l)
            if r.get('e')=='aim-search':
                a=r.get('unfoundFacingDeg')
                if isinstance(a,(int,float)) and a>=0:
                    vals.append(a); turns.append((r.get('ai'),r.get('t'),a))
    pooled=sum(vals)/len(vals) if vals else -1
    byt={}
    for ai,t,a in turns: byt.setdefault((ai,t),[]).append(a)
    tm=[sum(v)/len(v) for v in byt.values()]
    print(m,'samples=%d pooled=%.1f perTurnMean=%.1f turns=%d'%(len(vals),pooled,sum(tm)/len(tm),len(tm)))
