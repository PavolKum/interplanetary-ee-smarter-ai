import json
def wartrace(path,ais):
    war={}
    rows=[]
    with open(path,encoding='utf-8') as f:
        for l in f:
            r=json.loads(l)
            ai=r.get('ai')
            if ai not in ais: continue
            e=r.get('e'); t=r.get('t')
            if e=='director' and 'war' in r:
                k=(ai,t)
                if k not in war: war[k]=r.get('war')
            if e=='strategy':
                rows.append((ai,t,r.get('war'),r.get('reason'),r.get('commit')))
    for ai in ais:
        seq=[(t,w) for (a,t),w in sorted(war.items()) if a==ai]
        print(ai,'director war:',seq[:40])
    flips=[]
    for ai,t,w,reason,commit in rows:
        if reason=='peace':
            flips.append((ai,t,commit))
    print('peace-reason strategy rows:',flips)
wartrace('docs/playtests/data/v018m24-ai-decisions.jsonl',['Eddie'])
print('---M26---')
wartrace('docs/playtests/data/v019m26-ai-decisions.jsonl',['Ash'])
