import json
for m, path, ai in [('M24', 'docs/playtests/data/v018m24-ai-decisions.jsonl', 'Eddie'), ('M26', 'docs/playtests/data/v019m26-ai-decisions.jsonl', 'Ash')]:
    with open(path, 'r', encoding='utf-8') as f:
        rows = [json.loads(l) for l in f if l.strip()]
    for r in rows:
        if r.get('ai') == ai and r.get('t') in [14, 15, 16, 17, 18, 19, 20]:
            if r.get('e') in ['director', 'strategy']:
                print(m, ai, 'T', r.get('t'), r.get('e'), 'war=', r.get('war'), 'reason=', r.get('reason'), 'recentDamage=', r.get('recentDamage'), 'warTurn=', r.get('warTurn'))
"
