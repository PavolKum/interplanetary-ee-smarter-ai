import json

for match, filename in [
    ('M22', 'docs/playtests/data/v018m22-ai-decisions.jsonl'),
    ('M23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('M24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('M25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('M26', 'docs/playtests/data/v019m26-ai-decisions.jsonl')
]:
    with open(filename, 'r', encoding='utf-8') as f:
        records = [json.loads(line) for line in f if line.strip()]
    # filter for last game if multiple in file
    inits = [i for i, r in enumerate(records) if r.get('e') == 'init']
    if inits:
        # find last contiguous block of inits
        last_block_start = inits[0]
        for i in range(1, len(inits)):
            if inits[i] != inits[i-1] + 1:
                last_block_start = inits[i]
        records = records[last_block_start:]
    
    abandon_counts = {}
    aim_searches = []
    unspent_energy = []
    war_turns = {}
    peace_flips = []
    
    for r in records:
        e = r.get('e')
        if e == 'abandoned': # or in director
            pass
        if e == 'director':
            fails = r.get('placementFailures', {})
            for k, v in fails.items():
                abandon_counts[k] = abandon_counts.get(k, 0) + v
            if 'energyUnspent' in r:
                unspent_energy.append((r['t'], r['ai'], r['energyUnspent']))
            if 'war' in r and r.get('war'):
                if r['ai'] not in war_turns:
                    war_turns[r['ai']] = r['t']
        if e == 'strategy':
            if r.get('reason') == 'peace' and r['ai'] in war_turns and r['t'] > war_turns[r['ai']]:
                peace_flips.append((r['t'], r['ai'], r['reason']))
        if e == 'aim-search':
            aim_searches.append(r)
            
    print(f'=== {match} ===')
    print('War starts:', war_turns)
    print('Peace flips after war:', peace_flips)
    if aim_searches:
        unf_angles = [r['unfoundFacingDeg'] for r in aim_searches if r.get('unfoundFacingDeg', -1) >= 0]
        unf_away = sum(r.get('unfoundFacingAway', 0) for r in aim_searches)
        live_tot = sum(r.get('live', 0) for r in aim_searches)
        found_tot = sum(r.get('found', 0) for r in aim_searches)
        avg_ang = sum(unf_angles)/len(unf_angles) if unf_angles else 0
        print(f'Aim: live={live_tot}, found={found_tot} ({found_tot/live_tot*100:.1f}%), avg unfound angle={avg_ang:.1f} deg, unfound facing away (>90) count={unf_away}')
"
