[0m$ [0mpython -c "
import json,collections
rows=[json.loads(l) for l in open('docs/playtests/data/v019m25-human-telemetry.jsonl',encoding='utf-8')]
ai=[json.loads(l) for l in open('docs/playtests/data/v019m25-ai-decisions.jsonl',encoding='utf-8')]
smart={'Donnels','Sarai','Zenon'}
paid=collections.Counter()
for r in ai:
    if r.get('e')=='fire-paid' and r.get('destination')=='jogi' and r.get('ai') in smart: paid[r['t']]+=1
cr={}; pop={}
for x in rows:
    t=x.get('turn')
    if x['eventType']=='resource_credit': cr[t]=(x['credit']['energyBefore'],x['credit']['energyRefreshed'])
    elif x['eventType']=='turn_end' and x.get('state'): pop[t]=x['state']['player']['resources']['populationMillions']
print('t  eb(t)=resid(phase t-1)  prod(t)  popEnd(t)  dpop(t)  paid@jogi(t)')
for t in sorted(cr):
    if t<20: continue
    ebp,erp=cr[t]
    dpop=(pop.get(t,0)-pop.get(t-1,0)) if (t in pop and t-1 in pop) else None
    print(t, ebp, erp, pop.get(t), dpop, paid.get(t,0))
"
