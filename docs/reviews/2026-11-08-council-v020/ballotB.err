[0m$ [0mpython -c "
import json,collections
rows=[json.loads(l) for l in open('docs/playtests/data/v019m26-human-telemetry.jsonl',encoding='utf-8')]
ai=[json.loads(l) for l in open('docs/playtests/data/v019m26-ai-decisions.jsonl',encoding='utf-8')]
paid=collections.Counter(); fire=collections.Counter()
for r in ai:
    if r.get('e')=='fire-paid' and r.get('destination')=='jogi': paid[r['t']]+=1
    if r.get('e')=='fire': fire[r['t']]+=1
cr={}; pop={}
for x in rows:
    t=x.get('turn')
    if x['eventType']=='resource_credit': cr[t]=(x['credit']['energyBefore'],x['credit']['energyRefreshed'])
    elif x['eventType']=='turn_end' and x.get('state'): pop[t]=x['state']['player']['resources']['populationMillions']
    elif x['eventType']=='damage': pass
print('t  eb(t) prod(t)  popEnd(t)  dpop(t-1->t)  paid@jogi(t)')
for t in sorted(cr):
    if t<20: continue
    ebp,erp=cr[t]
    dpop=(pop.get(t,0)-pop.get(t-1,0)) if (t in pop and t-1 in pop) else None
    print(t, ebp, erp, pop.get(t), dpop, paid.get(t,0))
"
