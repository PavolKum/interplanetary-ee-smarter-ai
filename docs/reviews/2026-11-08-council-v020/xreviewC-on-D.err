import json

path = 'docs/playtests/data/v019m26-human-telemetry.jsonl'
turns_data = {}
with open(path, 'r', encoding='utf-8') as f:
    for line in f:
        rec = json.loads(line)
        t = rec.get('turn')
        et = rec.get('eventType')
        if t not in turns_data:
            turns_data[t] = {}
        if et == 'resource_credit':
            turns_data[t]['energyBefore'] = rec.get('credit', {}).get('energyBefore')
        elif et == 'turn_end':
            res = rec.get('state', {}).get('player', {}).get('resources', {})
            turns_data[t]['pop'] = res.get('populationMillions')
            turns_data[t]['energyLeftPlanning'] = res.get('energy')

print("Turn | energyBefore | Pop at turn_end | Pop delta from prev turn_end")
prev_pop = None
for t in range(20, 31):
    d = turns_data.get(t, {})
    pop = d.get('pop')
    delta = pop - prev_pop if pop is not None and prev_pop is not None else None
    print(f"T{t:02d} | energyBefore={d.get('energyBefore'):>5} | pop={pop} | delta={delta}")
    prev_pop = pop
