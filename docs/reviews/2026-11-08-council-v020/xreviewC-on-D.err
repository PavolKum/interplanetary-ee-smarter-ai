import json

aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in [('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'), ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl')]:
    print(f"=== {m_name} ===")
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('e') == 'economy' and rec.get('t') in (14, 15, 16):
                ai = rec.get('ai')
                if m_name == 'm25' and ai in aborted_m25: continue
                if ai in ('Beastie', 'Armiger'): continue
                print(f"  {ai} T{rec.get('t')}: energyPerTurn={rec.get('energyPerTurn')}")
