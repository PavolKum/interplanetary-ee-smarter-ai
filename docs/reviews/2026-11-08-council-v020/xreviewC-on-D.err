import re
from collections import Counter

for m_name, path in [('m25', 'docs/playtests/data/v019m25-monitor.log'), ('m26', 'docs/playtests/data/v019m26-monitor.log')]:
    abandon_counts = Counter()
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            # Look for abandoned <items>
            m = re.findall(r'abandoned\s+([A-Za-z0-9,x\s]+?)(?:;|\)|\||\.|$)', line)
            for match in m:
                # split by comma
                items = match.split(',')
                for item in items:
                    item = item.strip()
                    if not item: continue
                    # check if item has "xN"
                    xm = re.match(r'^([A-Za-z]+)(?:x(\d+))?$', item)
                    if xm:
                        bld = xm.group(1)
                        cnt = int(xm.group(2)) if xm.group(2) else 1
                        abandon_counts[bld] += cnt
    print(f"=== {m_name} Abandoned Placements (total {sum(abandon_counts.values())}) ===")
    for bld, cnt in abandon_counts.most_common(12):
        print(f"  {bld}: {cnt}")
