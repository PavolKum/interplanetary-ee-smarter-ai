import json

path = 'docs/playtests/data/v019m26-human-telemetry.jsonl'
events = []
with open(path, 'r', encoding='utf-8') as f:
    for line in f:
        rec = json.loads(line)
        et = rec.get('eventType')
        t = rec.get('turn')
        if t in range(21, 27):
            if et == 'resource_credit':
                events.append((t, 'resource_credit', rec.get('phase'), rec.get('credit', {}).get('energyBefore'), rec.get('credit', {}).get('energyRefreshed')))
            elif et == 'turn_end':
                res = rec.get('state', {}).get('player', {}).get('resources', {})
                events.append((t, 'turn_end', res.get('energy'), res.get('energyPerTurn'), res.get('populationMillions')))
            elif et == 'damage':
                dmg = rec.get('damage') or {}
                popD = dmg.get('populationDamage') or 0
                bldD = dmg.get('buildingDamage') or 0
                if popD > 0 or bldD > 0:
                    events.append((t, 'damage', dmg.get('targetBuildingId'), popD, bldD))

current_turn = None
for ev in events:
    if ev[0] != current_turn:
        current_turn = ev[0]
        print(f"\n--- Turn {current_turn} ---")
    if ev[1] == 'resource_credit':
        print(f"  RoundStart credit: energyBefore={ev[3]}, energyRefreshed={ev[4]}")
    elif ev[1] == 'turn_end':
        print(f"  turn_end: energy={ev[2]}, energyPerTurn={ev[3]}, population={ev[4]}")
    elif ev[1] == 'damage':
        print(f"  damage: target={ev[2]}, popDmg={ev[3]}, bldDmg={ev[4]}")
