import json

matches = [
    ('m22', 'docs/playtests/data/v018m22-ai-decisions.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]
aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in matches:
    print(f"=== {m_name} ===")
    ai_data = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            ai = rec.get('ai')
            if m_name == 'm25' and ai in aborted_m25: continue
            if ai in ('Gear', 'Turing', 'Spiral', 'Tarkoy', 'Armiger'): continue
            t = rec.get('t')
            e = rec.get('e')
            if ai not in ai_data: ai_data[ai] = {}
            if t not in ai_data[ai]: ai_data[ai][t] = {}
            ai_data[ai][t][e] = rec

    for ai, turns in ai_data.items():
        total_unspent = 0.0
        total_income = 0.0
        war_turns_cnt = 0
        for t, evs in turns.items():
            strat = evs.get('strategy', {})
            if strat.get('war'):
                dir_ev = evs.get('director', {})
                econ_ev = evs.get('economy', {})
                e_left = dir_ev.get('energyLeft', 0)
                e_inc = econ_ev.get('energyPerTurn', 0)
                total_unspent += e_left
                total_income += e_inc
                war_turns_cnt += 1
        share = total_unspent / total_income if total_income > 0 else 0
        print(f"  {ai}: unspent share = {share:.1%} ({total_unspent:.0f} / {total_income:.0f}) over {war_turns_cnt} war turns")
