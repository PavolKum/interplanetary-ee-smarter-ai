391:                 int fromCommit;
392:                 hitByCommit = lastPhaseImpactsBy.TryGetValue(best.PlayerId, out fromCommit) && fromCommit > 0;
393:             }
394:             d.HitByCommit = hitByCommit;
395:             bool pulseReady = turn - lastStrikeTurn >= Math.Max(1, s.StrikeEvery);
396:             bool saturated = d.Passing >= s.MinPassingShots && (d.PassShare >= s.MinPassShare || d.Passing >= s.BigSalvoShots);
397:             bool broken = d.PassShare >= s.BrokenPassShare && d.Passing >= s.MinPassingShots;
398:             // v0.11.1: no "aim first" turn (Terra v0.11 #1: the engine resets every trajectory search each turn, so a turn of
399:             // aiming carries nothing over). A strike whose weapons find no trajectory is called off at firing time instead.
400:             // v0.12 (Sol #2): max-hold first, so a strike after MaxHoldTurns held or aborted turns fires whatever aims (it is
401:             // exempt from the abort), instead of another "saturated" strike that aborts again.
402:             if (holdTurns >= s.MaxHoldTurns && pulseReady && d.Passing > 0f)
403:             {
404:                 d.Fire = true; // never sit on weapons forever, small arsenals included
405:                 d.Reason = "max-hold";
406:             }
407:             else if (d.Passing > 0f && Attrition(weapons, lastWeapons, underAttack, s))
408:             {
409:                 // v0.14: use them or lose them, pulse or not (exempt from the abort, like max-hold).
410:                 d.Fire = true;
411:                 d.Reason = "attrition";
412:             }
413:             else if (ReturnFire(weapons, d.Passing, d.PassShare, hitByCommit, s))
414:             {
415:                 // v0.15.2: trade blows instead of waiting for a bigger salvo (v0.15.3: the abort still applies).
416:                 d.Fire = true;
417:                 d.Reason = "return-fire";
418:             }
419:             else if (d.Precision && weapons >= s.MinWeapons)
420:             {
421:                 // v0.16: a visible city with a credible kill does not wait for saturation or the pulse (subject to the abort).
422:                 d.Fire = true;
423:                 d.Reason = "precision";
424:             }
425:             else if (weapons >= s.MinWeapons && saturated && (pulseReady || broken))
426:             {
427:                 d.Fire = true;
428:                 d.Reason = pulseReady ? "saturated" : "broken";
429:             }
430:             else if (FreeFireHolds(weapons, d.Passing, freeEnergy, firingCost, s))
431:             {
432:                 // v0.16.2: holding would only add to energy that goes unspent (subject to the abort).
433:                 d.Fire = true;
434:                 d.Reason = "free-fire";
435:             }
436:             else
437:             {
438:                 d.Reason = weapons < s.MinWeapons ? "building" : !saturated ? "below-saturation" : "pulse-wait";
439:             }
440:             return d;
441:         }
442:     }
443: }
