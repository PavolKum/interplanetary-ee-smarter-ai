812:         private static void Increment(Dictionary<string, int> counts, string key)
813:         {
814:             int n;
815:             counts.TryGetValue(key, out n);
816:             counts[key] = n + 1;
817:         }
818: 
819:         // ---- guided strikes: which building on the target planet --------------------------------
820: 
821:         // v0.15 (Sol + Fable v0.14.2 audits): candidates are enemy cities we see now (live population) or saw before
822:         // (Shadow: the frozen observation, never hidden live values; cities never move), plus visible weapon buildings.
823:         // A per-volley ledger spreads the shots (VolleyPlanner). With no candidate the native choice runs; it also falls
824:         // back to a random point on the planet when it knows nothing (AIWeaponTargeting.cs:483-497), so that is logged.
825:         private static readonly Dictionary<int, KeyValuePair<int, Dictionary<string, float>>> s_volley = new Dictionary<int, KeyValuePair<int, Dictionary<string, float>>>();
826: 
827:         private static Dictionary<string, float> VolleyLedger(int playerId, int turn)
828:         {
829:             KeyValuePair<int, Dictionary<string, float>> entry;
830:             if (!s_volley.TryGetValue(playerId, out entry) || entry.Key != turn)
831:             {
832:                 entry = new KeyValuePair<int, Dictionary<string, float>>(turn, new Dictionary<string, float>());
833:                 s_volley[playerId] = entry;
834:             }
835:             return entry.Value;
836:         }
