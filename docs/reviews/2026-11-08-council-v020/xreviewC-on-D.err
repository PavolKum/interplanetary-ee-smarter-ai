import json
from collections import Counter

matches = [
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]
aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in matches:
    print(f"=== {m_name} Total Weapon Upgrades Across Match ===")
    total_upgs = Counter()
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('e') == 'director':
                ai = rec.get('ai')
                if m_name == 'm25' and ai in aborted_m25: continue
                wu = rec.get('weaponUpgrades', 0)
                if wu > 0:
                    total_upgs[ai] += wu
    print(total_upgs)
EOF
