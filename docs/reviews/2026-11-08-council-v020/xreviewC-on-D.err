516:             }
517:         }
518: 
519:         // v0.16 (Sol v0.16 re-check #3/#4): the payment boundary. PlayerWeaponHandler.CompleteFirstPhaseTargeting checks the
520:         // firing cost, marks the weapon targeted and spends. For an AI guided weapon whose completed trajectory lands on an
521:         // enemy planet with no visible strike candidate, it is refused exactly as native refuses an unaffordable shot
522:         // (IsFirstPhaseTargeted = false, nothing spent). Every successful AI payment is logged ("fire-paid").
523:         private static readonly FieldInfo s_handlerPlayer = AccessTools.Field(typeof(PlayerWeaponHandler), "m_playerData");
524:         private static readonly FieldInfo s_handlerResults = AccessTools.Field(typeof(PlayerWeaponHandler), "m_targetingResults");
525: 
526:         private static bool CompleteFirstPhasePrefix(PlayerWeaponHandler __instance, WeaponGameplayData weapon, TrajectoryCalculationResults trajectory,
527:             ref PlayerWeaponTargetingResult __result, out int __state)
528:         {
529:             __state = -1;
530:             if (!Plugin.Active) return true;
531:             PlayerData me = null;
532:             string reason = null, destName = "";
533:             // v0.16 (Sol re-check round 3): applicability first, outside the fail-closed region. Any error here allows the
534:             // shot (native behaviour); only an established AI guided shot can be refused on a guard error.
535:             try
536:             {
537:                 me = s_handlerPlayer != null ? s_handlerPlayer.GetValue(__instance) as PlayerData : null;
538:                 if (me == null || !Plugin.IsSmart(me)) return true; // the human's (or an original AI's) handler: untouched
539:                 if (!Plugin.BlindArtillery.Value || !IsGuided(weapon)) { __state = SafeEnergy(me); return true; }
540:             }
541:             catch (Exception e)
542:             {
543:                 ReportOnce("fire-guard-scope", e);
544:                 return true;
545:             }
546:             __state = SafeEnergy(me); // the paid-ledger snapshot cannot trigger a refusal
547:             try
548:             {
549:                 CelestialBody dest = trajectory != null ? trajectory.HitCelestialBody : null;
550:                 if (dest == null || dest.Player == null || dest.Player == me) return true; // not an enemy planet: no second phase
551:                 destName = dest.Player.UserNickName;
552:                 if (StrikeCandidateCount(me, dest.Player) > 0) return true;
553:                 reason = "no-visible-candidate";
554:             }
555:             catch (Exception e)
556:             {
557:                 ReportOnce("fire-guard", e);
558:                 reason = "guard-error"; // an established AI guided shot we could not check: fail closed
559:             }
560:             // Refusal is authoritative once decided: native's own refusal state (no payment), whatever the bookkeeping does.
561:             __state = -2;
562:             try
563:             {
564:                 Dictionary<WeaponGameplayData, PlayerWeaponTargetingResult> results =
565:                     s_handlerResults != null ? s_handlerResults.GetValue(__instance) as Dictionary<WeaponGameplayData, PlayerWeaponTargetingResult> : null;
566:                 PlayerWeaponTargetingResult r = null;
567:                 if (results != null && !results.TryGetValue(weapon, out r)) { r = new PlayerWeaponTargetingResult(weapon); results.Add(weapon, r); }
568:                 if (r != null) r.IsFirstPhaseTargeted = false;
569:                 __result = r;
570:             }
571:             catch (Exception e)
572:             {
573:                 ReportOnce("fire-refuse", e);
574:             }
575:             try
576:             {
577:                 Plugin.WriteDecision(new Json().Str("e", "fire-refused").Int("t", GameManager.CurrentTurn).Str("ai", me.UserNickName)
578:                     .Str("wid", weapon != null && weapon.WeaponData != null ? weapon.WeaponData.id.Value : "").Str("destination", destName)
579:                     .Str("reason", reason).ToString());
580:             }
581:             catch (Exception e)
582:             {
583:                 ReportOnce("fire-refused-log", e);
584:             }
585:             return false;
586:         }
587: 
588:         private static int SafeEnergy(PlayerData me)
589:         {
590:             try { return me.ResourceHandler.Energy; }
591:             catch (Exception e) { ReportOnce("fire-paid-snapshot", e); return -1; }
592:         }
593: 
594:         private static void CompleteFirstPhasePostfix(PlayerWeaponHandler __instance, WeaponGameplayData weapon, TrajectoryCalculationResults trajectory,
595:             PlayerWeaponTargetingResult __result, int __state)
596:         {
597:             if (__state < 0 || __result == null || !__result.IsFirstPhaseTargeted) return;
598:             try
599:             {
600:                 PlayerData me = s_handlerPlayer.GetValue(__instance) as PlayerData;
601:                 CelestialBody dest = trajectory != null ? trajectory.HitCelestialBody : null;
602:                 bool enemyDest = dest != null && dest.Player != null && dest.Player != me;
603:                 Plugin.WriteDecision(new Json().Str("e", "fire-paid").Int("t", GameManager.CurrentTurn).Str("ai", me.UserNickName)
604:                     .Str("wid", weapon.WeaponData != null ? weapon.WeaponData.id.Value : "").Bool("guided", IsGuided(weapon))
605:                     .Str("destination", enemyDest ? dest.Player.UserNickName : dest == null ? "none" : "own")
606:                     .Int("candidates", enemyDest ? StrikeCandidateCount(me, dest.Player) : -1)
607:                     .Int("energyPaid", Math.Max(0, __state - me.ResourceHandler.Energy)).ToString());
608:             }
609:             catch (Exception e)
610:             {
611:                 ReportOnce("fire-paid-log", e);
612:             }
613:         }
614: 
615:         // ---- what actually got fired; feeds reachability memory ---------------------------------
