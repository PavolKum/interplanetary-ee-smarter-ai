import json

matches = [
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]
aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in matches:
    print(f"=== {m_name} pulse-waits ===")
    turns = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            ai = rec.get('ai')
            if m_name == 'm25' and ai in aborted_m25: continue
            if ai in ('Gear', 'Turing', 'Spiral', 'Tarkoy', 'Beastie', 'Armiger'): continue
            t = rec.get('t')
            e = rec.get('e')
            if (ai, t) not in turns: turns[(ai, t)] = {}
            turns[(ai, t)][e] = rec
            
    for (ai, t), evs in sorted(turns.items()):
        strat = evs.get('strategy', {})
        if strat.get('reason') == 'pulse-wait':
            dir_ev = evs.get('director', {})
            e_left = dir_ev.get('energyLeft')
            print(f"  {ai} T{t}: energyLeft={e_left}")
