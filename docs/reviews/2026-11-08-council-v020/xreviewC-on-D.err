import json

matches = [
    ('m22', 'docs/playtests/data/v018m22-ai-decisions.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]
aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in matches:
    found_sum = 0
    live_sum = 0
    unfound_degs = []
    
    # We need to know which turns were firing turns for each AI
    firing_turns = set()
    turns_data = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            ai = rec.get('ai')
            if m_name == 'm25' and ai in aborted_m25: continue
            if ai in ('Gear', 'Turing', 'Spiral', 'Tarkoy', 'Armiger'): continue
            t = rec.get('t')
            e = rec.get('e')
            if (ai, t) not in turns_data: turns_data[(ai, t)] = {}
            turns_data[(ai, t)][e] = rec
            if e == 'fire-paid':
                firing_turns.add((ai, t))

    for (ai, t), evs in turns_data.items():
        if (ai, t) in firing_turns:
            aim = evs.get('aim-search')
            if aim:
                f_val = aim.get('found', 0)
                l_val = aim.get('live', 0)
                found_sum += f_val
                live_sum += l_val
                deg = aim.get('unfoundFacingDeg')
                if deg is not None:
                    unfound_degs.append(deg)

    pct = found_sum / live_sum if live_sum > 0 else 0
    mean_deg = sum(unfound_degs) / len(unfound_degs) if unfound_degs else 0
    print(f"{m_name}: found/live = {found_sum}/{live_sum} ({pct:.1%}), unfoundFacingDeg mean = {mean_deg:.1f} (samples={len(unfound_degs)})")
EOF
