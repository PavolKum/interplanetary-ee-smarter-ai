51:         public float CommitStickiness = 1.25f; // keep last turn's target unless another is worth this much more
52:         // At firing time, call a strike off below max(AbortBelowWeapons, AbortBelowShare x weapons) on target. v0.12: share 0
53:         // (v0.11.1 aborted 13 of 26 strikes at 30%, throwing away 6-15 aimed weapons while energy went unspent).
54:         public float AbortBelowShare = 0f;
55:         public int AbortBelowWeapons = 3;
56:         // v0.12 (Sol #2): a target our weapons found almost no trajectory onto (fewer than AbortBelowWeapons) this many turns
57:         // running is worth LowYieldDiscount of its value, so the commit moves instead of aborting at it forever.
58:         public int LowYieldTurns = 2;
59:         public float LowYieldDiscount = 0.25f;
60:         public float BigSalvoShots = 24f;     // this many expected through fires whatever the share (v0.10.1: 40 held at 44%)
61:         public float RollEnergyShare = 0.5f;   // share of its energy income a defender has left for rolls
62:         public float RollCost = 150f;          // energy per defense roll
63:         public float UnseenCover = 0.6f;       // coverage assumed for a planet whose buildings we never saw
64:         public float MinPassingShots = 12f;    // strike when at least this many shots are expected through...
65:         public float MinPassShare = 0.45f;     // ...and at least this share of the salvo
66:         public float BrokenPassShare = 0.7f;   // defenses this broken: strike again without waiting for the pulse
67:         public int StrikeEvery = 2;            // turns between strikes (2 = every other turn, as the human)
68:         public int MaxHoldTurns = 5;           // at war with weapons, never hold longer than this
69:         public int MinWeapons = 6;             // fewer weapons than this: keep building (until MaxHoldTurns)
70:         public int ObservedMinImpacts = 10;    // our own shots of a weapon at a target before they correct its coverage
71:         public float ObservedPriorWeight = 20f; // impacts' worth of weight on the modelled coverage
72:         public float DefaultChance = 0.8f;     // intercept chance assumed for defenses we have not seen
73:         // v0.14 attrition: fire what we have when the arsenal shrank since last turn by at least this share (and at least
74:         // AttritionMinLoss weapons). v0.13.1 Guts held at 26 -> 17 -> 11 -> 10 live weapons (T24-T27) waiting for a
75:         // saturating salvo while the human destroyed them unfired. 0 = off.
76:         public float AttritionLossShare = 0.15f;
77:         public int AttritionMinLoss = 2;
