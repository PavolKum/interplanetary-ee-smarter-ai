import json

for ai, path in [('Zenon', 'docs/playtests/data/v019m25-ai-decisions.jsonl'), ('Ash', 'docs/playtests/data/v019m26-ai-decisions.jsonl')]:
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('ai') == ai and rec.get('t') == 30 and rec.get('e') == 'strategy':
                print(f"{ai} T30 strategy: visibleCities={rec.get('visibleCities')}, precision={rec.get('precision')}")

# Check human counterintel
for m_name, path in [('m25', 'docs/playtests/data/v019m25-human-telemetry.jsonl'), ('m26', 'docs/playtests/data/v019m26-human-telemetry.jsonl')]:
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('turn') == 30 and rec.get('eventType') == 'turn_end':
                ci = rec.get('state', {}).get('player', {}).get('resources', {}).get('counterintelMultiplier')
                print(f"{m_name} Human T30 counterintelMultiplier={ci}")
