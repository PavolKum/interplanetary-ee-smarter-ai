import json, glob

matches = [
    ('m22', 'docs/playtests/data/v018m22-human-telemetry.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-human-telemetry.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-human-telemetry.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-human-telemetry.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-human-telemetry.jsonl'),
]

for m_name, path in matches:
    first_weap = None
    kd_t14 = kd_t16 = kd_t17 = kd_t20 = kd_t22 = None
    e_t14_16 = []
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            # check structure
            t = rec.get('turn')
            player = rec.get('player', {})
            blds = player.get('buildings', {})
            res = player.get('resources', {})
            
            # weapons check
            weap_count = sum(blds.get(w, 0) for w in ('Railgun', 'Coilcannon', 'Laser', 'Missile', 'NuclearMissile', 'MIRV'))
            if weap_count > 0 and first_weap is None:
                weap_types = {w: blds.get(w) for w in ('Railgun', 'Coilcannon', 'Laser', 'Missile', 'NuclearMissile', 'MIRV') if blds.get(w, 0) > 0}
                first_weap = (t, weap_types)
                
            if t == 14: kd_t14 = blds.get('KineticDefense', 0)
            if t == 16: kd_t16 = blds.get('KineticDefense', 0)
            if t == 17: kd_t17 = blds.get('KineticDefense', 0)
            if t == 20: kd_t20 = blds.get('KineticDefense', 0)
            if t == 22: kd_t22 = blds.get('KineticDefense', 0)
            
            if t in (14, 15, 16):
                ept = res.get('energyProductionPerTurn')
                if ept: e_t14_16.append(ept)

    print(f"Match {m_name}:")
    print(f"  First weapon: {first_weap}")
    print(f"  KineticDefense T14/T16/T17/T20/T22: {kd_t14}/{kd_t16}/{kd_t17}/{kd_t20}/{kd_t22}")
    print(f"  Human E/t T14-16: {e_t14_16}")
