import json

path = 'docs/playtests/data/v019m25-human-telemetry.jsonl'
turns_data = {}
with open(path, 'r', encoding='utf-8') as f:
    for line in f:
        rec = json.loads(line)
        t = rec.get('turn')
        et = rec.get('eventType')
        if t not in turns_data:
            turns_data[t] = {}
        if et == 'resource_credit':
            turns_data[t]['energyBefore'] = rec.get('credit', {}).get('energyBefore')
        elif et == 'turn_end':
            res = rec.get('state', {}).get('player', {}).get('resources', {})
            turns_data[t]['pop'] = res.get('populationMillions')
            turns_data[t]['energyLeftPlanning'] = res.get('energy')

# paid shots to jogi in m25
dec_path = 'docs/playtests/data/v019m25-ai-decisions.jsonl'
aborted = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}
paid_to_jogi = {}
with open(dec_path, 'r', encoding='utf-8') as f:
    for line in f:
        rec = json.loads(line)
        if rec.get('e') == 'fire-paid':
            if rec.get('ai') in aborted: continue
            if rec.get('destination') == 'jogi':
                t = rec.get('t')
                paid_to_jogi[t] = paid_to_jogi.get(t, 0) + 1

print("Turn | energyBefore | Pop | delta | paid_to_jogi")
prev_pop = None
for t in range(20, 39):
    d = turns_data.get(t, {})
    pop = d.get('pop')
    delta = pop - prev_pop if pop is not None and prev_pop is not None else None
    print(f"T{t:02d} | energyBefore={str(d.get('energyBefore')):>5} | pop={str(pop):>5} | delta={str(delta):>5} | paid={paid_to_jogi.get(t, 0)}")
    prev_pop = pop
