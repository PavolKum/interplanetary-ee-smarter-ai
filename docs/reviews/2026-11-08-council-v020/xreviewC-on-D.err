import json
from collections import Counter

matches = [
    ('m22', 'docs/playtests/data/v018m22-ai-decisions.jsonl', {'Eiai'}, {'Gear', 'Turing'}),
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl', {'Arc', 'Beastie'}, {'Spiral'}),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl', {'Eddie', 'Doc'}, {'Tarkoy'}),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl', {'Zenon', 'Donnels', 'Sarai'}, {'Beastie'}),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl', {'Ash', 'Hawking'}, {'Armiger'}),
]

aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path, eiais, originals in matches:
    dest_counts = Counter()
    total_paid = 0
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('e') == 'fire-paid':
                ai = rec.get('ai')
                if m_name == 'm25' and ai in aborted_m25: continue
                if ai not in eiais: continue
                total_paid += 1
                dest = rec.get('destination')
                if dest == 'jogi':
                    dest_counts['jogi'] += 1
                elif dest in eiais:
                    dest_counts['fellow_eiai'] += 1
                elif dest in originals:
                    dest_counts['original_ai'] += 1
                elif dest in ('own', 'none'):
                    dest_counts['own_none'] += 1
                else:
                    dest_counts['other'] += 1

    print(f"=== {m_name} (total {total_paid}) ===")
    for k, v in dest_counts.items():
        print(f"  {k}: {v} ({v/total_paid:.1%})")
EOF
