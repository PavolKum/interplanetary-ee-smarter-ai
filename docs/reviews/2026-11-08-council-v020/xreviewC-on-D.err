import json, glob

matches = [
    ('m22', 'docs/playtests/data/v018m22-ai-decisions.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]

for m_name, path in matches:
    first_rg = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('e') == 'original':
                ai = rec.get('ai')
                t = rec.get('t')
                blds = rec.get('buildings', {})
                if 'Railgun' in blds and blds['Railgun'] > 0:
                    if ai not in first_rg:
                        first_rg[ai] = (t, blds['Railgun'])
    print(f"Match {m_name} original AIs first Railgun:", first_rg)
