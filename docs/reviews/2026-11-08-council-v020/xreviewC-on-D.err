import json
from collections import Counter

path = 'docs/playtests/data/v019m26-ai-decisions.jsonl'
paid_by_turn = Counter()
paid_to_jogi = Counter()

with open(path, 'r', encoding='utf-8') as f:
    for line in f:
        rec = json.loads(line)
        if rec.get('e') == 'fire-paid':
            t = rec.get('t')
            dest = rec.get('destination')
