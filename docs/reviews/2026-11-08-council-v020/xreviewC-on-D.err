141:         // accuracy: share of shots planned to hit (AccuracyPlan); misses do not reach the target.
142:         // v0.15.1 (Sol v0.15 #4): accuracyById, when given, overrides `accuracy` per weapon id (guided weapons at their own
143:         // rate), the same split the firing quota uses, applied before the weapon families are combined.
144:         public static void EstimateSalvo(IDictionary<string, float> salvo, SalvoTarget target, float accuracy,
145:             Dictionary<string, Dictionary<string, float>> counters, StrategySettings s, IDictionary<string, float> accuracyById = null)
146:         {
147:             IDictionary<string, float> shotsByWeapon = target.Shots ?? salvo;
148:             float arriving = 0f, eligible = 0f, intercepts = 0f, rollsNeeded = 0f;
149:             foreach (KeyValuePair<string, float> shots in shotsByWeapon)
150:             {
151:                 if (shots.Value <= 0f) continue;
152:                 float rate = accuracy, byId;
153:                 if (accuracyById != null && accuracyById.TryGetValue(shots.Key, out byId)) rate = byId;
154:                 float n = shots.Value * Math.Max(0f, Math.Min(1f, rate));
155:                 arriving += n;
156:                 int defenses = 0;
157:                 float chance = 0f;
158:                 if (target.Defenses != null)
159:                 {
160:                     foreach (KeyValuePair<string, int> defense in target.Defenses)
161:                     {
162:                         Dictionary<string, float> stops;
163:                         float p;
164:                         if (defense.Value <= 0 || !counters.TryGetValue(defense.Key, out stops) || !stops.TryGetValue(shots.Key, out p) || p <= 0f) continue;
165:                         defenses += defense.Value;
166:                         chance = Math.Max(chance, p);
167:                     }
168:                 }
169:                 float cover;
170:                 float tries; // defenses in range of one impact; the game rolls them in turn until one succeeds
171:                 if (defenses > 0)
172:                 {
173:                     cover = Math.Min(s.MaxCover, defenses / (defenses + Math.Max(1e-3f, s.CoverHalf)));
174:                     tries = 1f + defenses / Math.Max(1f, s.OverlapDefenses);
175:                 }
176:                 else if (!target.DefensesSeen)
177:                 {
178:                     cover = s.UnseenCover; // never saw the planet: unknown is not absent
179:                     chance = s.DefaultChance;
180:                     tries = 1f;
181:                 }
182:                 else
183:                 {
184:                     cover = 0f;
185:                     chance = s.DefaultChance;
186:                     tries = 1f;
187:                 }
188:                 float stopChance = 1f - (float)Math.Pow(1f - chance, tries);
189:                 // Our own shots of this weapon at it correct the guessed coverage (defenses we never saw, better placement
190:                 // than assumed). Salvos that saturated its rolls understate it; the prior weight keeps a few shots from deciding.
