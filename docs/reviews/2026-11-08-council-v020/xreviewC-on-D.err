import json

matches = [
    ('m22', 'docs/playtests/data/v018m22-human-telemetry.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-human-telemetry.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-human-telemetry.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-human-telemetry.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-human-telemetry.jsonl'),
]

for m_name, path in matches:
    first_weap = None
    kd = {}
    e_t14_16 = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            if rec.get('eventType') == 'turn_end':
                t = rec.get('turn')
                state = rec.get('state', {})
                player = state.get('player', {})
                blds = {b['id'].replace('bui_', ''): b['count'] for b in player.get('buildings', [])}
                res = player.get('resources', {})
                
                # weapons
                weaps = {k: v for k, v in blds.items() if k in ('Railgun', 'Coilcannon', 'Laser', 'Missile', 'NuclearMissile', 'MIRV')}
                if weaps and first_weap is None:
                    first_weap = (t, weaps)
                
                kd[t] = blds.get('KineticDefense', 0)
                if t in (14, 15, 16):
                    e_t14_16[t] = res.get('energyPerTurn')

    print(f"Match {m_name}:")
    print(f"  First weapon: {first_weap}")
    print(f"  KineticDefense T14={kd.get(14)}, T16={kd.get(16)}, T17={kd.get(17)}, T20={kd.get(20)}, T22={kd.get(22)}")
    print(f"  Human energyPerTurn T14-16: {e_t14_16}")
