import re

for m_name, path in [('m25', 'docs/playtests/data/v019m25-monitor.log'), ('m26', 'docs/playtests/data/v019m26-monitor.log')]:
    rep_counts = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            # Look for "TXX <AI>: ... REP N (-XE -YM)"
            m = re.search(r'T\d+\s+([A-Za-z]+):.*REP\s+(\d+)\s+\(-(\d+)E\s+-(\d+)M\)', line)
            if m:
                ai, reps, e_cost, m_cost = m.group(1), int(m.group(2)), int(m.group(3)), int(m.group(4))
                if ai not in rep_counts:
                    rep_counts[ai] = {'reps': 0, 'e': 0, 'm': 0}
                rep_counts[ai]['reps'] += reps
                rep_counts[ai]['e'] += e_cost
                rep_counts[ai]['m'] += m_cost
    print(f"=== {m_name} Repairs ===")
    for ai, data in rep_counts.items():
        print(f"  {ai}: {data['reps']} reps (-{data['e']}E, -{data['m']}M)")
