import json

matches = [
    ('m22', 'docs/playtests/data/v018m22-ai-decisions.jsonl'),
    ('m23', 'docs/playtests/data/v018m23-ai-decisions.jsonl'),
    ('m24', 'docs/playtests/data/v018m24-ai-decisions.jsonl'),
    ('m25', 'docs/playtests/data/v019m25-ai-decisions.jsonl'),
    ('m26', 'docs/playtests/data/v019m26-ai-decisions.jsonl'),
]

aborted_m25 = {'Helios', 'Uuno', 'Ruffian', 'Nanto'}

for m_name, path in matches:
    print(f"=== {m_name} ===")
    ai_events = {}
    with open(path, 'r', encoding='utf-8') as f:
        for line in f:
            rec = json.loads(line)
            ai = rec.get('ai')
            if m_name == 'm25' and ai in aborted_m25:
                continue
            e = rec.get('e')
            t = rec.get('t')
            if ai not in ai_events:
                ai_events[ai] = {}
            if t not in ai_events[ai]:
                ai_events[ai][t] = {}
            ai_events[ai][t][e] = rec

    for ai, turns in ai_events.items():
        if ai in ('Gear', 'Turing', 'Spiral', 'Tarkoy', 'Beastie', 'Armiger'):
            continue # original AIs
        war_turns = []
        for t in sorted(turns.keys()):
            strat = turns[t].get('strategy')
            if strat and strat.get('war'):
                war_turns.append(t)
        print(f"  {ai} war turns:", war_turns[:10], f"total war turns {len(war_turns)}")

