1946:         // v0.6: when land plants cannot be placed (14 abandoned Solar Plants while 7 -> 22 buildings sat unpowered, 31 Oct 1v1),
1947:         // power the grid from the water.
1948:         private static BuildingData PickWaterPlant(AICore core, DirectorState d)
1949:         {
1950:             if (GameManager.CurrentTurn < d.WaterCooldownUntil) return null;
1951:             BuildingsData buildings = GameDataFileManager.GetDataFile<BuildingsData>();
1952:             PlayerAvailableBuildings available = core.PlayerData.BuildingHandler.AvailableBuildings;
1953:             BuildingData data = buildings.HasBuilding("bui_FloatingPlant") ? buildings.GetBuilding("bui_FloatingPlant") : null;
1954:             if (data != null && available.IsBuildingAvailable(data) && Affordable(core, data) && !Blocked(d, "bui_FloatingPlant")) return data;
1955:             return null;
1956:         }
1957: 
1958:         // ---- queue primitives ----------------------------------------------------------------------
1959: 
1960:         // A type whose placement gave up this turn, or (v0.11) one throttled because its placements keep failing: placements
1961:         // resolve after many are queued, so a full planet saw 22-55 of one type queued and abandoned every turn (v0.10.1
1962:         // Maverick T24-T28). A type abandoned 3+ times last turn is queued at most twice this turn. Candidate filters use
1963:         // this too, so a throttled type is skipped before it is picked (Terra v0.11 #4).
1964:         private static bool Blocked(DirectorState d, string id)
1965:         {
1966:             if (d.FailedThisTurn.Contains(id)) return true;
1967:             int abandoned, queuedNow;
1968:             d.AbandonedLastTurn.TryGetValue(id, out abandoned);
1969:             d.QueuedById.TryGetValue(id, out queuedNow);
1970:             bool backoff = PlacementBackoff.Throttled(d.BackoffUntil, id, d.Turn);
1971:             return (abandoned >= 3 || backoff) && queuedNow >= 2;
1972:         }
1973: 
1974:         private static Dictionary<string, int> NextBackoff(DirectorState last, int turns)
1975:         {
1976:             if (last == null) return new Dictionary<string, int>();
1977:             return PlacementBackoff.Next(last.BackoffUntil, last.PlacementFailures, last.QueuedById, last.Turn, turns);
1978:         }
